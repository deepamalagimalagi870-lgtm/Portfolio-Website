<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Management System</title>

    <!-- Connect CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation Bar -->
    <header>
        <div class="logo">
            🏥 HealthCare Hospital
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#services">Services</a>
            <a href="#doctors">Doctors</a>
            <a href="#appointment">Appointment</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- Home Section -->
    <section id="home" class="hero">

        <div class="hero-content">
            <h1>Welcome to HealthCare Hospital</h1>

            <p>
                Quality healthcare, experienced doctors and
                modern medical facilities for everyone.
            </p>

            <a href="#appointment" class="btn">
                Book Appointment
            </a>
        </div>

    </section>

    <!-- Services -->
    <section id="services" class="section">

        <h2>Our Services</h2>

        <div class="cards">

            <div class="card">
                <div class="icon">👨‍⚕️</div>
                <h3>Doctor Consultation</h3>
                <p>
                    Consult experienced doctors and get proper
                    medical guidance.
                </p>
            </div>

            <div class="card">
                <div class="icon">📅</div>
                <h3>Appointment Booking</h3>
                <p>
                    Book your hospital appointment easily and quickly.
                </p>
            </div>

            <div class="card">
                <div class="icon">💊</div>
                <h3>Pharmacy</h3>
                <p>
                    Get prescribed medicines from our hospital pharmacy.
                </p>
            </div>

            <div class="card">
                <div class="icon">🚑</div>
                <h3>Emergency Service</h3>
                <p>
                    24/7 emergency medical assistance for patients.
                </p>
            </div>

        </div>

    </section>

    <!-- Doctors -->
    <section id="doctors" class="section doctors-section">

        <h2>Our Doctors</h2>

        <div class="cards">

            <div class="doctor-card">
                <div class="doctor-image">👨‍⚕️</div>
                <h3>Dr. Rajesh Kumar</h3>
                <p>General Physician</p>
                <button>View Profile</button>
            </div>

            <div class="doctor-card">
                <div class="doctor-image">👩‍⚕️</div>
                <h3>Dr. Priya Sharma</h3>
                <p>Cardiologist</p>
                <button>View Profile</button>
            </div>

            <div class="doctor-card">
                <div class="doctor-image">👨‍⚕️</div>
                <h3>Dr. Arun Kumar</h3>
                <p>Orthopedic Specialist</p>
                <button>View Profile</button>
            </div>

        </div>

    </section>

    <!-- Appointment Form -->
    <section id="appointment" class="section">

        <h2>Book an Appointment</h2>

        <div class="appointment-box">

            <form>

                <label>Patient Name</label>
                <input
                    type="text"
                    placeholder="Enter patient name"
                    required
                >

                <label>Email</label>
                <input
                    type="email"
                    placeholder="Enter email"
                    required
                >

                <label>Phone Number</label>
                <input
                    type="tel"
                    placeholder="Enter phone number"
                    required
                >

                <label>Select Doctor</label>

                <select required>
                    <option value="">Choose Doctor</option>
                    <option>Dr. Rajesh Kumar</option>
                    <option>Dr. Priya Sharma</option>
                    <option>Dr. Arun Kumar</option>
                </select>

                <label>Appointment Date</label>

                <input
                    type="date"
                    required
                >

                <label>Message</label>

                <textarea
                    rows="4"
                    placeholder="Describe your problem"
                ></textarea>

                <button type="submit" class="submit-btn">
                    Book Appointment
                </button>

            </form>

        </div>

    </section>

    <!-- Contact -->
    <section id="contact" class="contact">

        <h2>Contact Us</h2>

        <p>📍 Davangere, Karnataka, India</p>
        <p>📞 +91 9876543210</p>
        <p>✉️ healthcarehospital@gmail.com</p>

    </section>

    <!-- Footer -->
    <footer>
        <p>
            © 2026 HealthCare Hospital Management System
        </p>
    </footer>

</body>
</html>